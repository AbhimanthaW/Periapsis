{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "approach_cell": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "dwell_s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "expected_artifact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "target_id",
          "approach_cell",
          "dwell_s",
          "priority",
          "evidence_id",
          "objective",
          "expected_artifact"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "stations"
  ],
  "additionalProperties": false
}
