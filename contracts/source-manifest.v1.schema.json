{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "synthetic"
              },
              "recipe_id": {
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
              "native_spacing_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "effective_scale_m": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "version",
              "kind",
              "recipe_id",
              "attribution",
              "native_spacing_m",
              "effective_scale_m",
              "limitations"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "source_backed"
              },
              "recipe_id": {
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
              "native_spacing_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "effective_scale_m": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "window_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "native_crs_wkt": {
                "type": "string",
                "minLength": 1
              },
              "vertical_reference": {
                "type": "string",
                "minLength": 1
              },
              "transform_policy": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version",
              "kind",
              "recipe_id",
              "attribution",
              "native_spacing_m",
              "effective_scale_m",
              "limitations",
              "url",
              "source_sha256",
              "window_sha256",
              "native_crs_wkt",
              "vertical_reference",
              "transform_policy"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false
}
