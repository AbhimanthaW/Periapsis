{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cell": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "id",
        "cell"
      ],
      "additionalProperties": false
    },
    "shelter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cell": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "id",
        "cell"
      ],
      "additionalProperties": false
    },
    "completed_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "remaining_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "reserve_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "closures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "cells"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "checkpoint",
    "shelter",
    "completed_task_ids",
    "remaining_s",
    "reserve_s",
    "closures"
  ],
  "additionalProperties": false
}
