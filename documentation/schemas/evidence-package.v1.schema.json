{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mission": {
          "minLength": 1,
          "title": "Mission",
          "type": "string"
        },
        "instrument": {
          "minLength": 1,
          "title": "Instrument",
          "type": "string"
        },
        "modality": {
          "minLength": 1,
          "title": "Modality",
          "type": "string"
        },
        "product_class": {
          "minLength": 1,
          "title": "Product Class",
          "type": "string"
        },
        "archive_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Archive Url",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "catalogue_status": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ],
          "title": "Catalogue Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mission",
        "instrument",
        "modality",
        "product_class",
        "archive_url",
        "version",
        "catalogue_status"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "Footprint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "status": {
          "enum": [
            "native_geographic",
            "canonical_verified",
            "unavailable",
            "invalid",
            "untransformable"
          ],
          "title": "Status",
          "type": "string"
        },
        "coverage_kind": {
          "enum": [
            "observation",
            "usable_support"
          ],
          "title": "Coverage Kind",
          "type": "string"
        },
        "geometry": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "Global": "#/$defs/Global",
                  "MultiPolygon": "#/$defs/MultiPolygon",
                  "Polygon": "#/$defs/Polygon"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Polygon"
                },
                {
                  "$ref": "#/$defs/MultiPolygon"
                },
                {
                  "$ref": "#/$defs/Global"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometry"
        },
        "transform": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transform"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "product_id",
        "source_url",
        "status",
        "coverage_kind"
      ],
      "title": "Footprint",
      "type": "object"
    },
    "Global": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Global",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Global",
      "type": "object"
    },
    "Inventory": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "modality": {
          "minLength": 1,
          "title": "Modality",
          "type": "string"
        },
        "dataset_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Dataset Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "Global": "#/$defs/Global",
                  "MultiPolygon": "#/$defs/MultiPolygon",
                  "Polygon": "#/$defs/Polygon"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Polygon"
                },
                {
                  "$ref": "#/$defs/MultiPolygon"
                },
                {
                  "$ref": "#/$defs/Global"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "authority": {
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        }
      },
      "required": [
        "id",
        "modality",
        "dataset_ids",
        "status",
        "source_url",
        "authority"
      ],
      "title": "Inventory",
      "type": "object"
    },
    "MarsCRS": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "const": "Mars",
          "title": "Body",
          "type": "string"
        },
        "frame": {
          "minLength": 1,
          "title": "Frame",
          "type": "string"
        },
        "definition": {
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "latitude_type": {
          "anyOf": [
            {
              "enum": [
                "planetocentric",
                "planetographic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude Type"
        },
        "longitude_direction": {
          "anyOf": [
            {
              "enum": [
                "east",
                "west"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude Direction"
        },
        "longitude_domain": {
          "anyOf": [
            {
              "enum": [
                "signed",
                "unsigned"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude Domain"
        },
        "equatorial_radius_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equatorial Radius M"
        },
        "polar_radius_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polar Radius M"
        }
      },
      "required": [
        "body",
        "frame",
        "definition"
      ],
      "title": "MarsCRS",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MultiPolygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "source_crs": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarsCRS"
            },
            {
              "type": "null"
            }
          ]
        },
        "processing_level": {
          "minLength": 1,
          "title": "Processing Level",
          "type": "string"
        },
        "readiness": {
          "enum": [
            "usable",
            "needs_preprocessing",
            "unusable",
            "unknown"
          ],
          "title": "Readiness",
          "type": "string"
        },
        "observation_extent_complete": {
          "default": false,
          "title": "Observation Extent Complete",
          "type": "boolean"
        },
        "support_extent_complete": {
          "default": false,
          "title": "Support Extent Complete",
          "type": "boolean"
        },
        "variables": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Variables",
          "type": "array"
        },
        "native_spacing_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Spacing M"
        },
        "effective_scale_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Scale M"
        },
        "acquisition": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compatibility_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compatibility Key"
        },
        "provenance": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Provenance",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "id",
        "dataset_id",
        "version",
        "source_url",
        "source_crs",
        "processing_level",
        "readiness",
        "provenance"
      ],
      "title": "Product",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "package_id": {
      "minLength": 1,
      "title": "Package Id",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/Dataset"
      },
      "title": "Datasets",
      "type": "array"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/Product"
      },
      "title": "Products",
      "type": "array"
    },
    "footprints": {
      "items": {
        "$ref": "#/$defs/Footprint"
      },
      "title": "Footprints",
      "type": "array"
    },
    "inventories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Inventory"
      },
      "title": "Inventories",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "version",
    "datasets",
    "products",
    "footprints"
  ],
  "title": "Package",
  "type": "object"
}
