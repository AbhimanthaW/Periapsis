{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Calculation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        }
      },
      "required": [
        "id",
        "requirements"
      ],
      "title": "Calculation",
      "type": "object"
    },
    "Line": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "LineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Line",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MultiPolygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Point",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Point",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "variable": {
          "minLength": 1,
          "title": "Variable",
          "type": "string"
        },
        "product_classes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Product Classes",
          "type": "array"
        },
        "modalities": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Modalities",
          "type": "array"
        },
        "processing_levels": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Processing Levels",
          "type": "array"
        },
        "max_native_spacing_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Native Spacing M"
        },
        "max_effective_scale_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Effective Scale M"
        },
        "acquisition_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "variable",
        "product_classes"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "geometry": {
      "discriminator": {
        "mapping": {
          "LineString": "#/$defs/Line",
          "MultiPolygon": "#/$defs/MultiPolygon",
          "Point": "#/$defs/Point",
          "Polygon": "#/$defs/Polygon"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "$ref": "#/$defs/Line"
        },
        {
          "$ref": "#/$defs/Polygon"
        },
        {
          "$ref": "#/$defs/MultiPolygon"
        }
      ],
      "title": "Geometry"
    },
    "corridor_width_m": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corridor Width M"
    },
    "requested": {
      "$ref": "#/$defs/Calculation"
    },
    "fallbacks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Calculation"
      },
      "title": "Fallbacks",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "geometry",
    "requested"
  ],
  "title": "CapabilityQuery",
  "type": "object"
}
